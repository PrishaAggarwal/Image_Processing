        "#2. Weightage Avg. Filter\n",
        "img = cv2.imread('/content/heart.jpg')#, cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "if img is None:\n",
        "    print(\"Error\")\n",
        "else:\n",
        "    # Define weighted kernel\n",
        "    kernel = np.array([[50, 50, 50, 50, 50],\n",
        "                       [50, 50, 50, 50, 50],\n",
        "                       [50, 50, 1, 50, 50],\n",
        "                       [50, 50, 50, 50, 50],\n",
        "                       [50, 50, 50, 50, 50]])\n",
        "\n",
        "    # Normalize kernel so sum is 1\n",
        "    kernel = kernel / kernel.sum()\n",
        "\n",
        "    # Apply weighted average smoothing\n",
        "    smoothed_img1 = cv2.filter2D(img, -1, kernel) #-1 means keep same depth as original image..i.e bit depth should be same\n",
        "    #The range of possible values each pixel can have.\n",
        "    #The type of data stored for each pixel (integer, float, etc).\n",
        "\n",
        "    plt.figure(figsize=(10,5))\n",
        "\n",
        "    plt.subplot(1,2,1)\n",
        "    plt.title('Original Image')\n",
        "    plt.imshow(img, cmap='gray')\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.subplot(1,2,2)\n",
        "    plt.title('Weighted Avg. Smoothed Image')\n",
        "    plt.imshow(smoothed_img1, cmap='gray')\n",
        "    plt.axis('off')\n",
        "\n",
        "    plt.show()"
